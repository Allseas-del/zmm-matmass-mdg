{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.allseas.zmmmatmassmdg",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "0.8.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "crossNavigation": {
      "inbounds": {
        "upload": {
          "semanticObject": "Material",
          "action": "massUploadMdg",
          "title": "{{appTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "deviceTypes": { "desktop": true, "tablet": false, "phone": false }
  },
  "sap.ui5": {
    "dependencies": { "minUI5Version": "1.120.0", "libs": { "sap.ui.core": {} } },
    "models": { "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "com.allseas.zmmmatmassmdg.i18n.i18n" } } }
  }
}
